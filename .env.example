# Copy this file to .env and fill in your own values.
# Expo only exposes env vars prefixed with EXPO_PUBLIC_ to the app bundle —
# never put a secret key here that isn't safe to ship on-device.

# Supabase (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# USDA FoodData Central — free key: https://fdc.nal.usda.gov/api-key-signup
EXPO_PUBLIC_USDA_FDC_API_KEY=your-usda-key

# Open Food Facts needs no key — included for completeness / rate-limit headers
EXPO_PUBLIC_OFF_USER_AGENT=FitByte-StudyApp/1.0 (contact: your-email@example.com)
